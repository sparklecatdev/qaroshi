      {
        "speaker": "A",
        "qaroshi": "nëm mi naro-lo nëru-yu.",
        "english": "I will rest at home.",
        "ipa": "/nəm mi na.ˈɾo.lo nə.ˈɾu.ju/",
        "sound_out": "nuhm mee nah-ROH-loh nuh-ROO-yoo."
